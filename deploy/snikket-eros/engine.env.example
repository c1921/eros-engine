# /etc/snikket-eros/engine.env
#
# 真实文件不要提交：含数据库口令、JWT 签名密钥、caller secret、模型 API key。
# 这里只保留键与已确认的非敏感默认值。

# --- 数据库 ---
DATABASE_URL=postgres://eros:CHANGE_ME@127.0.0.1:5432/eros
SUPABASE_JWT_SECRET=CHANGE_ME
CALLER_SECRET=CHANGE_ME

# --- 模型网关 ---
OPENROUTER_API_KEY=
LOCAL_API_KEY=
OLLAMA_API_KEY=

# --- 监听与配置路径 ---
BIND_ADDR=127.0.0.1:18080
MODEL_CONFIG_PATH=/etc/eros-engine/snikket-model.toml
RUST_LOG=info

# --- 行为开关 ---
WORLD_DISABLED=true
SNAPSHOT_DISABLED=true
CHAT_NOISE_CANCELLATION_DISABLED=true

# 多气泡分段节奏。false = 启用（按自然停顿拆 2-3 条、逐条落库并延时发送）。
CHAT_REPLY_PACING_DISABLED=false

# 可选：把每次组装的原始 prompt 落盘，便于核对提示词是否真的到达模型。
# 开启后记得定期清理，日志在 compose 挂载的 ./prompt-logs。
# PROMPT_LOG_DIR=/var/log/eros-prompts
